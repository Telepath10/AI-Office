# --- Brain storage ---
# Working brain (scratch: hot.md, log.md, .raw, evidence, drafts) — local, gitignored
SEO_BRAIN_HOME=.seo-brain
# Obsidian vault (published finals only). `~` is expanded.
SEO_OBSIDIAN_VAULT=~/Documents/Obsidian/Office

# --- SEO Data APIs ---
# DataForSEO (pay-per-use, recommended for live data)
DATAFORSEO_LOGIN=you@example.com
DATAFORSEO_PASSWORD=your_password
# Default SERP/Labs location+language (per-call location_name overrides). ChatGPT LLM-mentions always use US/English.
DATAFORSEO_DEFAULT_LOCATION=India
DATAFORSEO_DEFAULT_LANGUAGE=English

# Google API key (free tier for PageSpeed Insights + CrUX)
GOOGLE_API_KEY=AIzaSy...

# Google Cloud OAuth (free, for Search Console + GA4)
# Authenticated via gcloud ADC with your OWN Desktop OAuth client (gcloud's built-in client is
# blocked by Google for the GSC/Analytics scopes: "This app is blocked"). Run:
#   gcloud auth application-default login --client-id-file="$HOME/.config/gcloud/seo-office-oauth-client.json" --scopes=https://www.googleapis.com/auth/cloud-platform,https://www.googleapis.com/auth/webmasters.readonly,https://www.googleapis.com/auth/analytics.readonly
# Optional: GOOGLE_CLOUD_QUOTA_PROJECT=<project> overrides the ADC file's quota_project_id.
# Blank = gcloud default (~/.config/gcloud/application_default_credentials.json)
GOOGLE_APPLICATION_CREDENTIALS=

# Bing Webmaster (free, for backlinks)
BING_WEBMASTER_API_KEY=...

# Moz Link Explorer (optional; DataForSEO backlinks are primary). moz_api.py reads only
# MOZ_API_KEY (Moz API v2 token from moz.com/products/api), via backlinks_auth.py. Leave blank to skip.
MOZ_API_KEY=

# Python used by scripts/setup-venvs.sh to (re)build the 4 venvs. Pin a non-Homebrew python so `brew upgrade` doesn't break them.
# SEO_PYTHON=

# Python interpreter for the vendored scripts
# Create with: bash scripts/setup-venvs.sh
# Relative paths resolve from the repo root (servers chdir there on startup).
PYTHON_BIN=vendored/claude-seo/.venv/bin/python

# Firecrawl (free tier available, for JS-rendered scraping + full-site crawling)
FIRECRAWL_API_KEY=fc-...

# Crawlers MCP — Python venv for Scrapling + Crawl4AI (free, open-source)
CRAWLERS_PYTHON_BIN=vendored/crawlers/.venv/bin/python3
CRAWLERS_SCRIPTS_DIR=vendored/crawlers/scripts

# --- API surface ---
# Backlinks: DataForSEO (primary) + Bing + CommonCrawl. Moz is optional/skipped.
#   scripts also accept BING_WEBMASTER_API_KEY; MCP tools accept BING_API_KEY as alias.
# AI/GEO (LLM): DataForSEO LLM Mentions — same DATAFORSEO_LOGIN/PASSWORD.
#   Enable AI Optimization in the DataForSEO dashboard if live calls return product errors.
# GSC property and GA4 property ID are stored per client by onboarding (gsc_property / ga4_property_id).

# ── Social trends & news (social MCP, agent-reach toolchain) ─────────────────
# YouTube + Google News need nothing. Use DEDICATED accounts only (never personal/client):
# X/Twitter: log in to the dedicated account, export cookies with Cookie-Editor, copy auth_token and ct0.
# TWITTER_AUTH_TOKEN=
# TWITTER_CT0=
# Reddit: log in to the dedicated account, export cookies with Cookie-Editor, copy reddit_session.
# REDDIT_SESSION=
# Instagram/Facebook: no env vars. Use a dedicated Chrome profile with the OpenCLI extension,
# logged in to the dedicated accounts, and keep Chrome open while content runs.
# SOCIAL_TIMEOUT_MS=300000

# ── Optional timeouts (ms) ───────────────────────────────────────────────────
# FIRECRAWL_TIMEOUT_MS=90000
# DATAFORSEO_TIMEOUT_MS=60000
# GOOGLE_TIMEOUT_MS=60000
# google-apis MCP, OAuth token refresh / gcloud fallback:
# GCLOUD_TIMEOUT_MS=30000
# python-scripts MCP, per script run:
# PYTHON_TIMEOUT_MS=60000
# crawlers MCP, Scrapling/Crawl4AI Python runs:
# CRAWLERS_TIMEOUT_MS=120000
# vault MCP Python runs. Unset = 120000 for render/check, 300000 for export_pdfs:
# VAULT_PYTHON_TIMEOUT_MS=

# Playwright browser cache (Scrapling/Crawl4AI Chromium). Blank = ~/Library/Caches/ms-playwright
# PLAYWRIGHT_BROWSERS_PATH=

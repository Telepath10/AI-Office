{
  "agent": "seo-slop",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(node mcp/*)",
      "Bash(python3 *)",
      "Bash(bash scripts/*)",
      "Bash(vendored/*/.venv/bin/python *)",
      "Read(./skills/**)",
      "Read(./.seo-brain/**)"
    ],
    "deny": [
      "Edit",
      "Write",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(**/.env)",
      "Bash(cat .env)",
      "Bash(cat .env *)",
      "Bash(cat *.env)",
      "Bash(*source .env*)",
      "Bash(*. .env*)",
      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(*printenv*)",
      "Bash(env)"
    ]
  }
}
